{
  "name": "my-pi-extensions",
  "version": "1.0.0",
  "description": "Pi extensions framework: meta-skills, isolation, and more",
  "private": true,
  "scripts": {
    "sync": "npx tsx scripts/sync.ts",
    "sync:force": "npx tsx scripts/sync.ts --skip-smoke",
    "smoke": "npx tsx scripts/smoke-test.ts",
    "sync:dry": "npx tsx scripts/sync.ts --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "cleanup": "rm -rf ~/tmp/pi-test/ && rm -f ~/.pi/worktree-sessions/*.jsonl && echo 'Cleaned test artifacts'"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "vitest": "^4.1.7"
  }
}
